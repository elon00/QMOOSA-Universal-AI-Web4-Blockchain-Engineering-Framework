# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# QuickNode RPC Infrastructure
QUICKNODE_ARBITRUM_RPC_URL="https://arbitrum-mainnet.quiknode.pro/YOUR_API_KEY/"
QUICKNODE_ARBITRUM_SEPOLIA_URL="https://arbitrum-sepolia.quiknode.pro/YOUR_API_KEY/"
QUICKNODE_WSS_URL="wss://arbitrum-mainnet.quiknode.pro/YOUR_API_KEY/"

# Target Blockchain
ARBITRUM_CHAIN_ID="42161"
ARBITRUM_SEPOLIA_CHAIN_ID="421614"

# x402 Bazaar Protocol Facilitator
X402_BAZAAR_REGISTRY="https://x402.org/bazaar/qmoosa"
X402_SETTLEMENT_CHAIN="Arbitrum"
